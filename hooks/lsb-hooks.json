{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lsb_cpp_check.py\"",
            "commandWindows": "python \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\lsb_cpp_check.py\"",
            "timeout": 10,
            "statusMessage": "Checking C++ style..."
          }
        ]
      }
    ]
  }
}
